{
  "format": "typesys.mission/1",
  "name": "fleet-readiness-board",
  "requirement": "A fleet readiness board for the squadron. Maintainers see every aircraft with its readiness and maintenance status, and the components in poor condition so they can be replaced. Viewers see the aircraft and their components too, but not an aircraft's maintenance status or where it is deployed. A maintainer can open a work order against a maintenance event; a viewer cannot. Someone not signed in sees nothing.",
  "host": {
    "module": "@typesys/domain-airforce",
    "build": "buildAirforceTestbed",
    "identities": "resolveDemoIdentity",
    "workflows": "airforceWorkflows"
  },
  "callers": {
    "maintainer": {
      "token": "demo-maintainer-token",
      "description": "SSgt Rivera, a maintainer"
    },
    "lead": {
      "token": "demo-lead-token",
      "description": "MSgt Okafor, a maintenance lead"
    },
    "viewer": {
      "token": "demo-viewer-token",
      "description": "a read-only viewer"
    },
    "anonymous": {
      "token": "",
      "description": "someone not signed in"
    }
  },
  "uses": {
    "types": [
      "airforce.Aircraft",
      "airforce.Component",
      "airforce.MaintenanceEvent"
    ],
    "actions": [
      "CreateMaintenanceWorkOrder"
    ]
  },
  "views": [
    {
      "name": "FleetReadiness",
      "title": "Fleet readiness",
      "type": "airforce.Aircraft",
      "fields": [
        "tailNumber",
        "model",
        "readinessStatus",
        "maintenanceStatus",
        "needsAttention"
      ],
      "limit": 100
    },
    {
      "name": "ComponentCondition",
      "title": "Components",
      "type": "airforce.Component",
      "fields": [
        "name",
        "partNumber",
        "aircraftId",
        "condition"
      ],
      "limit": 200
    },
    {
      "name": "MaintenanceEvents",
      "title": "Maintenance events",
      "type": "airforce.MaintenanceEvent",
      "fields": [
        "aircraftId",
        "eventType",
        "occurredAt",
        "description"
      ],
      "limit": 100
    }
  ],
  "acceptance": [
    {
      "id": "maintainer-sees-maintenance-status",
      "kind": "reads",
      "as": "maintainer",
      "type": "airforce.Aircraft",
      "objectId": "AF86-0147",
      "sees": [
        "tailNumber",
        "readinessStatus",
        "maintenanceStatus"
      ]
    },
    {
      "id": "lead-sees-maintenance-status",
      "kind": "reads",
      "as": "lead",
      "type": "airforce.Aircraft",
      "objectId": "AF86-0212",
      "sees": [
        "tailNumber",
        "maintenanceStatus"
      ]
    },
    {
      "id": "viewer-sees-aircraft-without-status-or-location",
      "kind": "reads",
      "as": "viewer",
      "type": "airforce.Aircraft",
      "objectId": "AF86-0147",
      "sees": [
        "tailNumber",
        "model"
      ],
      "withheld": [
        "maintenanceStatus",
        "deploymentLocation"
      ]
    },
    {
      "id": "viewer-sees-components",
      "kind": "reads",
      "as": "viewer",
      "type": "airforce.Component",
      "objectId": "comp-002",
      "sees": [
        "name",
        "partNumber",
        "condition"
      ]
    },
    {
      "id": "maintainer-filters-components-by-condition",
      "kind": "query",
      "as": "maintainer",
      "query": {
        "type": "airforce.Component",
        "filter": {
          "property": "condition",
          "operator": "eq",
          "value": "fair"
        }
      },
      "atLeast": 1,
      "because": "no component is in poor condition in this data, so the check filters by a condition some component has: the board's poor-condition list is the same query"
    },
    {
      "id": "viewer-lists-fleet",
      "kind": "query",
      "as": "viewer",
      "query": {
        "type": "airforce.Aircraft"
      },
      "atLeast": 2
    },
    {
      "id": "maintainer-offered-work-order",
      "kind": "offered",
      "as": "maintainer",
      "type": "airforce.MaintenanceEvent",
      "objectId": "EVT-9002",
      "action": "CreateMaintenanceWorkOrder",
      "offered": true
    },
    {
      "id": "viewer-not-offered-work-order",
      "kind": "offered",
      "as": "viewer",
      "type": "airforce.MaintenanceEvent",
      "objectId": "EVT-9002",
      "action": "CreateMaintenanceWorkOrder",
      "offered": false
    },
    {
      "id": "anonymous-refused-aircraft",
      "kind": "refused",
      "as": "anonymous",
      "type": "airforce.Aircraft",
      "objectId": "AF86-0147"
    },
    {
      "id": "anonymous-refused-components",
      "kind": "refused",
      "as": "anonymous",
      "type": "airforce.Component",
      "objectId": "comp-002"
    }
  ]
}
