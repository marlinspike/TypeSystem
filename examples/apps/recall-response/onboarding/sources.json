                      "signedOffBy": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "receivedAt",
                      "lotsQuarantined",
                      "dosesQuarantined",
                      "shipmentsInTransit",
                      "signedOffBy"
                    ]
                  },
                  {
                    "type": "null"
