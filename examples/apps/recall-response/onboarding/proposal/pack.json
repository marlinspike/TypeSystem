{
  "format": "typesys.pack/1",
  "name": "coldchain",
  "version": "1.0.0",
  "description": "coldchain, onboarded from Recall Exchange",
  "requires": {},
  "contents": {
    "types": [
      {
        "name": "coldchain.Recall",
        "version": "1.0.0",
        "schema": {
          "$id": "urn:typesys:type:coldchain.Recall:1.0.0",
          "title": "Recall",
          "description": "A manufacturer's recall notice posted to the recall exchange, with this distributor's effectiveness response once one is filed.",
          "type": "object",
          "properties": {
            "recallNumber": {
              "type": "string",
              "description": "The exchange's recall number, e.g. RCL-26-0412."
            },
            "firm": {
              "type": "string",
              "description": "The manufacturer that issued the recall."
            },
            "product": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "ndc11": {
                  "type": "string",
                  "pattern": "^[0-9]{11}$"
                }
              },
              "required": [
                "name",
                "ndc11"
              ],
              "description": "The recalled product: its name and its eleven-digit NDC."
            },
            "affectedLots": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "lotCode": {
                    "type": "string"
                  },
                  "expiry": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "lotCode"
                ]
              },
              "description": "Every lot the manufacturer recalled, by lot code and expiry, including lots this distributor never held."
            },
            "recallClass": {
              "type": "string",
              "enum": [
                "CLASS_I",
                "CLASS_II",
                "CLASS_III"
              ],
              "description": "The recall's hazard class, CLASS_I (most serious) to CLASS_III."
            },
            "healthHazard": {
              "type": "string",
              "description": "The manufacturer's health hazard evaluation"
            },
            "disclosure": {
              "type": "string",
              "enum": [
                "PUBLIC",
                "EMBARGOED"
              ],
              "description": "PUBLIC, or EMBARGOED while the notice is not yet public."
            },
            "lifecycle": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "TERMINATED"
              ],
              "description": "ACTIVE, or TERMINATED once the manufacturer ends the recall."
            },
            "issuedOn": {
              "type": "string",
              "format": "date",
              "description": "The day the notice was issued."
            },
            "responseStatus": {
              "type": "string",
              "enum": [
                "PENDING",
                "RECEIVED"
              ],
              "description": "PENDING until this distributor's response is on file, then RECEIVED."
            },
            "response": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "receivedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "lotsQuarantined": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "dosesQuarantined": {
                      "type": "integer"
                    },
                    "shipmentsInTransit": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "signedOffBy": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "receivedAt",
                    "lotsQuarantined",
                    "dosesQuarantined",
                    "shipmentsInTransit",
                    "signedOffBy"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "This distributor's effectiveness response, once filed."
            }
          },
          "required": [
            "recallNumber",
            "firm",
            "product",
            "affectedLots",
            "recallClass",
            "disclosure",
            "lifecycle",
            "responseStatus"
          ],
          "x-actions": {
            "actions": [
              "FileRecallResponse"
            ]
          },
          "x-policy": {
            "objectPolicy": "coldchain.read-recall",
            "propertyPolicies": {
              "healthHazard": "coldchain.health"
            }
          },
          "x-metadata": {
            "onboardedFrom": "openapi:recall-exchange#/components/schemas/Notice"
          }
        },
        "traits": []
      }
    ],
    "traits": [],
    "actions": [
      {
        "id": "action-coldchain-file-recall-response",
        "name": "FileRecallResponse",
        "version": "1.0.0",
        "description": "Files this distributor's one effectiveness response to a notice: the lots it quarantined, their doses, the shipments still in transit and who signed it off.",
        "applicableTypes": [
          "coldchain.Recall"
        ],
        "target": {
          "idFrom": "recallNumber",
          "type": "coldchain.Recall"
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "recallNumber": {
              "type": "string"
            },
            "lotsQuarantined": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Lot codes from the notice that this distributor holds and has quarantined"
            },
            "dosesQuarantined": {
              "type": "integer",
              "minimum": 0
            },
            "shipmentsInTransit": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Shipment references carrying a quarantined lot that are still in transit"
            },
            "signedOffBy": {
              "type": "string",
              "minLength": 1,
              "description": "The person responsible for the response"
            }
          },
          "required": [
            "recallNumber",
            "lotsQuarantined",
            "dosesQuarantined",
            "shipmentsInTransit",
            "signedOffBy"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object"
        },
        "outputType": "coldchain.Recall",
        "authorizationPolicy": "coldchain.invoke-file-recall-response",
        "implementation": {
          "dataSourceId": "recall-exchange",
          "operation": "POST /exchange/v1/notices/{recallNumber}/responses"
        },
        "sideEffects": "mutates",
        "idempotency": "none",
        "auditRequired": true,
        "preconditions": []
      }
    ],
    "dataSources": [
      {
        "id": "recall-exchange",
        "name": "Recall Exchange",
        "kind": "http"
      }
    ],
    "mappings": [
      {
        "id": "map-coldchain-recall",
        "typeName": "coldchain.Recall",
        "target": "property",
        "targetName": "*",
        "dataSourceId": "recall-exchange",
        "operation": "get",
        "resolutionMode": "live"
      }
    ]
  },
  "requirements": {
    "computed": [],
    "preconditions": [],
    "policies": [
      "coldchain.health",
      "coldchain.invoke-file-recall-response",
      "coldchain.read-recall"
    ],
    "dataSources": [
      "recall-exchange"
    ],
    "types": [],
    "actions": []
  },
  "digest": "sha256:fc6cf5097a9dd18b7231153b7d0aba6f4e97be118c38da96e02d39fdc2c080c9"
}
