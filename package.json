{
  "name": "typesys-monorepo",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlinspike/TypeSystem.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:postgres": "tsc -b packages/registry-store-postgres packages/adapter-postgres",
    "migrate:postgres": "npm run migrate --workspace=@typesys/registry-store-postgres && npm run migrate --workspace=@typesys/adapter-postgres",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:install": "npm ci --prefix tools/eslint",
    "lint": "node tools/eslint/node_modules/eslint/bin/eslint.js -c tools/eslint/eslint.config.js .",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "node tools/eslint/node_modules/typescript/bin/tsc -p tools/eslint/tsconfig.lint.json",
    "smoke:mcp": "tsx scripts/smoke-test-mcp.ts",
    "smoke:mcp-http": "tsx scripts/smoke-test-mcp-http.ts",
    "conformance:mcp": "tsx scripts/mcp-conformance.ts",
    "mcp:http": "tsx packages/demo-web/src/mcp-http.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "load-test": "tsx scripts/load-test.ts",
    "demo": "tsx packages/demo-web/src/server.ts",
    "clean": "tsc -b --clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
