{
  // Type information for the browser clients (the Studio, ADR-0061; the mission applications, ADR-0063; @typesys/ui, ADR-0082), which run with the DOM and JSX
  // and never in Node. Like tsconfig.lint.json, it only checks; scripts/build-clients.ts bundles.
  "extends": "./tsconfig.lint.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["../../packages/*/src/**/client/**/*.ts", "../../packages/*/src/**/client/**/*.tsx", "../../packages/ui/src/**/*.ts", "../../packages/ui/src/**/*.tsx", "../../packages/ui/test/**/*.ts"],
  "exclude": []
}
