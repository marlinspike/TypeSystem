{
  // Type information for ESLint only; never used to build. Resolves @typesys/* to each package's
  // source so linting needs no prior `npm run build`, and covers tests and scripts, which the
  // per-package tsconfigs (include: ["src"]) leave out.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      // Subpath exports name a source file of their own (`@typesys/demo-web/deployments` is src/deployments.ts).
      "@typesys/demo-web/*": ["../../packages/demo-web/src/*.ts"],
      "@typesys/*": ["../../packages/*/src/index.ts"]
    }
  },
  "include": [
    "../../packages/*/src/**/*.ts",
    "../../packages/*/test/**/*.ts",
    "../../scripts/**/*.ts",
    "../../examples/services/*/server.d.mts",
    "../../tools/terminology/**/*.ts",
    "../../tools/mutation/**/*.ts",
    "../../vitest.config.ts"
  ],
  // Browser clients have their own: tsconfig.client.json.
  "exclude": ["../../packages/*/src/**/client/**", "../../packages/ui/src/**", "../../packages/ui/test/**"]
}
