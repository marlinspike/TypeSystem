    "type": "git",
    "url": "git+https://github.com/marlinspike/TypeSystem.git",
    "directory": "packages/workflow-postgres"
  },
  "homepage": "https://github.com/marlinspike/TypeSystem/tree/main/packages/workflow-postgres#readme",
  "keywords": ["typesys", "workflow", "durable-execution", "postgres"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "migrations"],
  "dependencies": {
    "@typesys/workflow": "0.1.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
