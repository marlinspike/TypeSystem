{
  "name": "@typesys/react",
  "version": "0.1.0",
  "description": "Headless React bindings for TypeS: typed hooks over the governed SDK client (queries, objects, Actions with preview), and form fields and table columns derived from the model. No components, no styling; every value still decided by the runtime per caller.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlinspike/TypeSystem.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/marlinspike/TypeSystem/tree/main/packages/react#readme",
  "keywords": [
    "typesys",
    "react",
    "hooks",
    "headless",
    "forms"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@typesys/core": "0.1.0",
    "@typesys/sdk": "0.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-test-renderer": "18.3.1",
    "@typesys/domain-airforce": "0.1.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  }
}
