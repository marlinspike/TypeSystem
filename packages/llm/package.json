    "directory": "packages/llm"
  },
  "homepage": "https://github.com/marlinspike/TypeSystem/tree/main/packages/llm#readme",
  "keywords": [
    "typesys",
    "llm",
    "anthropic",
    "openai",
    "ollama",
    "vllm",
    "structured-output"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
