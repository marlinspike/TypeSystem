{
  "name": "@typesys/app",
  "version": "0.1.0",
  "description": "What a compiled TypeSystem application runs on: the three-valued expression operators its generated code calls, the flow helpers its workflows use (bounded iteration, timeouts, reads that may fail), and the server that assembles the governed API, the workflow engine and its models.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./expr": "./dist/expr.js",
    "./flow": "./dist/flow.js",
    "./server": "./dist/server.js",
    "./read": "./dist/read.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlinspike/TypeSystem.git",
    "directory": "packages/app"
  },
  "homepage": "https://github.com/marlinspike/TypeSystem/tree/main/packages/app#readme",
  "keywords": [
    "typesys",
    "application",
    "compiler",
    "workflow"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@typesys/core": "0.1.0",
    "@typesys/http": "0.1.0",
    "@typesys/llm": "0.1.0",
    "@typesys/sdk": "0.1.0",
    "@typesys/workflow": "0.1.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@typesys/domain-airforce": "0.1.0",
    "@types/express": "5.0.6"
  }
}
