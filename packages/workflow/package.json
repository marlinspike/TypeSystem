    "directory": "packages/workflow"
  },
  "homepage": "https://github.com/marlinspike/TypeSystem/tree/main/packages/workflow#readme",
  "keywords": [
    "typesys",
    "workflow",
    "saga",
    "approvals",
    "ai-agents",
    "simulation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@typesys/core": "0.1.0",
